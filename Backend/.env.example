# ==============================================================================
# Environment Configuration Template for IdeaProof Backend
#
# IMPORTANT:
# - NEVER put real credentials, API keys, or production secrets in this file.
# - Copy this file to '.env' in this directory and supply your own values.
# - The '.env' file is ignored by Git and must never be committed.
# ==============================================================================

# Server port (optional, defaults to 3000)
PORT=3000

# Groq API Key for AI startup evaluation
GROQ_API_KEY=your_groq_api_key_here

# MongoDB connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>)
MONGODB_URI=your_mongodb_connection_string_here

# Secret key for JWT generation and verification
JWT_SECRET=your_jwt_secret_key_here
